local function performSlide(toLeft)
    if toLeft then
        if isAtTeamCheck then
            isAtTeamCheck = false
            WallCheckToggle.Visible = true
            WallCheckToggle.Position = UDim2.new(1, 0, 0, 0)
            TweenService:Create(TeamCheckToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(-1, 0, 0, 0)}):Play()
            local t = TweenService:Create(WallCheckToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
            t:Play()
            t.Completed:Connect(function()
                if not isAtTeamCheck then TeamCheckToggle.Visible = false end
            end)
        else
            isAtTeamCheck = true
            TeamCheckToggle.Visible = true
            TeamCheckToggle.Position = UDim2.new(1, 0, 0, 0)
            TweenService:Create(WallCheckToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(-1, 0, 0, 0)}):Play()
            local t = TweenService:Create(TeamCheckToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
            t:Play()
            t.Completed:Connect(function()
                if isAtTeamCheck then WallCheckToggle.Visible = false end
            end)
        end
    else
        if isAtTeamCheck then
            isAtTeamCheck = false
            WallCheckToggle.Visible = true
            WallCheckToggle.Position = UDim2.new(-1, 0, 0, 0)
            TweenService:Create(TeamCheckToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, 0, 0, 0)}):Play()
            local t = TweenService:Create(WallCheckToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
            t:Play()
            t.Completed:Connect(function()
                if not isAtTeamCheck then TeamCheckToggle.Visible = false end
            end)
        else
            isAtTeamCheck = true
            TeamCheckToggle.Visible = true
            TeamCheckToggle.Position = UDim2.new(-1, 0, 0, 0)
            TweenService:Create(WallCheckToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, 0, 0, 0)}):Play()
            local t = TweenService:Create(TeamCheckToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
            t:Play()
            t.Completed:Connect(function()
                if isAtTeamCheck then WallCheckToggle.Visible = false end
            end)
        end
    end
end

local function setupSlideInput(button)
    button.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not UserInputService:GetFocusedTextBox() then
            slideDragging = true
            slideStartPos = input.Position.X
        end
    end)
end

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if slideDragging then
            slideDragging = false
            local deltaX = input.Position.X - slideStartPos
            if math.abs(deltaX) > 30 then
                performSlide(deltaX < 0)
            end
        end
    end
end)

