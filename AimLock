local function AnimateFrame(frame, open, targetPos)
    local originalSize = UDim2.new(0, 145, 0, frame.Name == "PartSelectorFrame" and 252 or 160)
    local collapsedSize = UDim2.new(0, 145, 0, 0)
    if open then
        frame.Size = collapsedSize
        frame.BackgroundTransparency = 1
        frame.Visible = true
        TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = originalSize,
            BackgroundTransparency = 0,
            Position = targetPos
        }):Play()
    else
        local t = TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = collapsedSize,
            BackgroundTransparency = 1
        })
        t:Play()
        t.Completed:Connect(function()
            if not open then
                frame.Visible = false
            end
        end)
    end
end

