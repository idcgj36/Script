local CurrentHighlight = nil
local function ClearHighlight()
    if CurrentHighlight then
        CurrentHighlight:Destroy()
        CurrentHighlight = nil
    end
end

local function ApplyHighlight(target, isNPC)
    if CurrentHighlight and CurrentHighlight.Parent == target then
        if not isNPC then
            local color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
            CurrentHighlight.FillColor = color
            CurrentHighlight.OutlineColor = color
        end
        return
    end
    ClearHighlight()
    local hl = Instance.new("Highlight")
    hl.OutlineTransparency = 0
    hl.FillTransparency = 0.5
    if isNPC then
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
    else
        local color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
        hl.FillColor = color
        hl.OutlineColor = color
    end
    pcall(function()
        hl.Parent = target
        CurrentHighlight = hl
    end)
end

local function checkWallVisibility(character, partName)
    local targetPart = character:FindFirstChild(partName) or character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local destination = targetPart.Position
    local direction = destination - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {Camera}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    table.insert(ignoreList, character)
    params.FilterDescendantsInstances = ignoreList
    local result = workspace:Raycast(origin, direction, params)
    return result == nil
end

local function getClosestTarget()
    local closest = nil
    local shortestDistance = math.huge
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            if TeamCheck and v.Team == LocalPlayer.Team then continue end
            if WallCheck and not checkWallVisibility(v.Character, TargetPart) then continue end
            local pos, onScreen = Camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
            if onScreen then
                local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if distance < shortestDistance then
                    closest = v.Character
                    shortestDistance = distance
                end
            end
        end
    end
    if AllowedNPC then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(obj) and obj ~= LocalPlayer.Character then
                local hum = obj.Humanoid
                if hum.Health > 0 and obj.Parent ~= nil then
                    if WallCheck and not checkWallVisibility(obj, TargetPart) then continue end
                    local pos, onScreen = Camera:WorldToViewportPoint(obj.HumanoidRootPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                        if distance < shortestDistance then
                            closest = obj
                            shortestDistance = distance
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if enabled then
        if not LockedTarget or not LockedTarget.Parent or not LockedTarget:FindFirstChild("HumanoidRootPart") or not LockedTarget:FindFirstChild("Humanoid") or LockedTarget.Humanoid.Health <= 0 then
            LockedTarget = getClosestTarget()
        end
        if LockedTarget and LockedTarget.Parent and LockedTarget:FindFirstChild("HumanoidRootPart") then
            local isNPC = not Players:GetPlayerFromCharacter(LockedTarget)
            if not isNPC and TeamCheck then
                local p = Players:GetPlayerFromCharacter(LockedTarget)
                if p and p.Team == LocalPlayer.Team then
                    LockedTarget = nil
                    ClearHighlight()
                    return
                end
            end
            if WallCheck and not checkWallVisibility(LockedTarget, TargetPart) then
                LockedTarget = nil
                ClearHighlight()
                return
            end
            local targetHit = nil
            if TargetPart == "HumanoidRootPart" then
                targetHit = LockedTarget:FindFirstChild("HumanoidRootPart") or LockedTarget:FindFirstChild("UpperTorso") or LockedTarget:FindFirstChild("Torso")
            elseif TargetPart == "Head" then
                targetHit = LockedTarget:FindFirstChild("Head")
            elseif TargetPart == "LeftHand" then
                targetHit = LockedTarget:FindFirstChild("LeftHand") or LockedTarget:FindFirstChild("Left Arm")
            elseif TargetPart == "RightHand" then
                targetHit = LockedTarget:FindFirstChild("RightHand") or LockedTarget:FindFirstChild("Right Arm")
            elseif TargetPart == "LeftFoot" then
                targetHit = LockedTarget:FindFirstChild("LeftFoot") or LockedTarget:FindFirstChild("Left Leg")
            elseif TargetPart == "RightFoot" then
                targetHit = LockedTarget:FindFirstChild("RightFoot") or LockedTarget:FindFirstChild("Right Leg")
            end
            local root = LockedTarget:FindFirstChild("HumanoidRootPart")
            local hum = LockedTarget:FindFirstChild("Humanoid")
            if root and targetHit and hum and hum.Health > 0 and LockedTarget.Parent ~= nil then
                ApplyHighlight(LockedTarget, isNPC)
                local offsetVector = Vector3.new(CamOffsetX, CamOffsetY, CamOffsetZ)
                local finalTargetPos = targetHit.Position + offsetVector
                if PredictionEnabled and root.Velocity then
                    local ping = 0.1
                    local predX = root.Velocity.X * (PredictionX * ping)
                    local predY = root.Velocity.Y * (PredictionY * ping)
                    local predZ = root.Velocity.Z * (PredictionX * ping)
                    finalTargetPos = finalTargetPos + Vector3.new(predX, predY, predZ)
                end
                if AimType == "Aim" then
                    local targetCF = CFrame.new(Camera.CFrame.Position, finalTargetPos)
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, AimSmooth)
                elseif AimType == "Lock" then
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local targetLookPos = Vector3.new(finalTargetPos.X, myRoot.Position.Y, finalTargetPos.Z)
                        local targetCF = CFrame.new(myRoot.Position, targetLookPos)
                        myRoot.CFrame = myRoot.CFrame:Lerp(targetCF, LockSmooth)
                    end
                end
            else
                LockedTarget = nil
                ClearHighlight()
            end
        else
            LockedTarget = nil
            ClearHighlight()
        end
    else
        ClearHighlight()
    end
end)

local function tween(obj, info, props) TweenService:Create(obj, info, props):Play() end

local function setAim(v)
    enabled = v
    if enabled then
        Check.Visible = true
        tween(Check, TweenInfo.new(0.2), {ImageTransparency = 0})
        tween(AimLockBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.05})
    else
        LockedTarget = nil
        ClearHighlight()
        tween(Check, TweenInfo.new(0.2), {ImageTransparency = 1})
        tween(AimLockBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.15})
        task.delay(0.2, function() if not enabled then Check.Visible = false end end)
    end
end

local function toggleSettings()
    settingsOpen = not settingsOpen
    local rotationTarget = settingsOpen and 180 or 0
    local sizeTarget = settingsOpen and UDim2.new(0, 155, 0, 345) or UDim2.new(0, 155, 0, 0)
    local positionTarget = settingsOpen and UDim2.new(0.5, 0, 0, -3) or UDim2.new(0.5, 0, 0, 22)
    local transparencyTarget = settingsOpen and 0 or 1
    tween(Icon, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = rotationTarget})
    if settingsOpen then
        ScrollHolder.Visible = true
        tween(ScrollHolder, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = sizeTarget,
            Position = positionTarget,
            BackgroundTransparency = transparencyTarget
        })
    else
        selectorOpen = false
        adjustOpen = false
        AnimateFrame(PartSelectorFrame, false)
        AnimateFrame(AdjustFrame, false)
        local t = TweenService:Create(ScrollHolder, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = sizeTarget,
            Position = positionTarget,
            BackgroundTransparency = transparencyTarget
        })
        t:Play()
        t.Completed:Connect(function()
            if not settingsOpen then
                ScrollHolder.Visible = false
            end
        end)
    end
end

