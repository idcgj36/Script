local function updateCanvas()
	local count = #allImages
	local rows = math.ceil(count / perRow)
	ImageList.CanvasSize = UDim2.new(0,0,0, rows * (size + padding) + padding)
end

reflow = function()
	local width = ImageList.Size.X.Offset
	local newPerRow = math.max(1, math.floor((width - padding) / (size + padding)))
	if newPerRow == perRow then
		updateCanvas()
		return
	end
	perRow = newPerRow
	for i, btn in ipairs(imageButtons) do
		local row = math.floor((i-1)/perRow)
		local col = (i-1)%perRow
		btn.Position = UDim2.new(0, col*(size+padding)+padding, 0, row*(size+padding)+padding)
	end
	updateCanvas()
end

local function createImage(data, index)
	local id = data.id
	local obj = data.obj
	local btn = Instance.new("ImageButton")
	btn.Parent = ImageList
	btn.Size = UDim2.new(0,size,0,size)
	btn.BackgroundTransparency = 1
	btn.Image = id
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,8)
	corner.Parent = btn
	local row = math.floor((index-1)/perRow)
	local col = (index-1)%perRow
	btn.Position = UDim2.new(0, col*(size+padding)+padding, 0, row*(size+padding)+padding)
	table.insert(imageButtons, btn)

	btn.MouseButton1Click:Connect(function()
		currentId = id
		currentObject = obj
		PreviewImage.Image = id
		if Rbx then Rbx.Text = id end
		if ParentLabel and obj then ParentLabel.Text = obj:GetFullName() end
		PreviewFrame.Visible = true
	end)
end

local function scan()
	clear()
	allImages = {}
	imageButtons = {}
	Loading.Visible = true
	spinning = true
	local seen = {}

	local function add(id, obj)
		local formattedId = parseAssetId(id)
		if formattedId and not seen[formattedId] then
			seen[formattedId] = true
			table.insert(allImages, {id = formattedId, obj = obj})
		end
	end

	local function scanContainer(container)
		if not container then return end
		pcall(function()
			for _, id in ipairs(getImages(container)) do
				add(id, container)
			end
			for _, obj in ipairs(container:GetDescendants()) do
				if obj ~= ScreenGui then
					for _, id in ipairs(getImages(obj)) do
						add(id, obj)
					end
				end
			end
		end)
	end

	pcall(function()
		for _, service in ipairs(game:GetChildren()) do
			scanContainer(service)
		end
	end)

	pcall(function()
		scanContainer(CoreGui)
	end)

	for _, plr in ipairs(Players:GetPlayers()) do
		pcall(function()
			if plr:FindFirstChild("PlayerGui") then scanContainer(plr.PlayerGui) end
			if plr.Character then scanContainer(plr.Character) end
			if plr:FindFirstChild("Backpack") then scanContainer(plr.Backpack) end
		end)
	end

	local index = 0
	for _, data in ipairs(allImages) do
		index += 1
		createImage(data, index)
		if index % 40 == 0 then
			ImageCount.Text = tostring(index)
			updateCanvas()
			RunService.Heartbeat:Wait()
		end
	end

	reflow()
	ImageCount.Text = tostring(#allImages)
	spinning = false
	Loading.Visible = false
end

if CopyBtn1 then
