	if input == resizeInput and resizing then
		local delta = input.Position - resizeStart
		local newWidth = math.clamp(startSizeOffset.X + delta.X, minWidth, maxWidth)
		local newHeight = math.clamp(startSizeOffset.Y + delta.Y, minHeight, maxHeight)
		local widthDelta = newWidth - startSizeOffset.X
		local heightDelta = newHeight - startSizeOffset.Y

		MainDex.Size = UDim2.new(MainDex.Size.X.Scale, newWidth, MainDex.Size.Y.Scale, newHeight)
		MainDex.Position = UDim2.new(MainDex.Position.X.Scale, startPosOffset.X + widthDelta/2, MainDex.Position.Y.Scale, startPosOffset.Y + heightDelta/2)

		ImageList.Size = UDim2.new(0, newWidth - 10, 0, newHeight - 51)
		reflow()

		expandedSize = Vector2.new(newWidth, newHeight)
	end
end)

