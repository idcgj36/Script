local function isImageLike(v)
	if typeof(v) ~= "string" then return false end
	v = v:gsub("%s+", "")
	if v == "" then return false end
	if tonumber(v) then return true end
	if string.find(v, "rbxassetid://") or string.find(v, "rbxasset://") or string.find(v, "rbxthumb://") or string.find(v, "http") then
		return true
	end
	return false
end

local function getImages(obj)
	local t = {}
	pcall(function()
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			table.insert(t, obj.Image)
		elseif obj:IsA("ImageHandleAdornment") then
			table.insert(t, obj.Image)
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			table.insert(t, obj.Texture)
		elseif obj:IsA("MeshPart") then
			table.insert(t, obj.TextureID)
		elseif obj:IsA("SpecialMesh") then
			table.insert(t, obj.TextureId)
		elseif obj:IsA("Sky") then
			table.insert(t, obj.SkyboxBk)
			table.insert(t, obj.SkyboxDn)
			table.insert(t, obj.SkyboxFt)
			table.insert(t, obj.SkyboxLf)
			table.insert(t, obj.SkyboxRt)
			table.insert(t, obj.SkyboxUp)
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
			table.insert(t, obj.Texture)
		elseif obj:IsA("Shirt") then
			table.insert(t, obj.ShirtTemplate)
		elseif obj:IsA("Pants") then
			table.insert(t, obj.PantsTemplate)
		elseif obj:IsA("ShirtGraphic") then
			table.insert(t, obj.Graphic)
		elseif obj:IsA("SurfaceAppearance") then
			table.insert(t, obj.ColorMap)
			table.insert(t, obj.NormalMap)
			table.insert(t, obj.RoughnessMap)
			table.insert(t, obj.MetalnessMap)
		elseif obj:IsA("Tool") then
			table.insert(t, obj.TextureId)
		elseif obj:IsA("HumanoidDescription") then
			table.insert(t, obj.Face)
		elseif obj:IsA("StringValue") then
			if isImageLike(obj.Value) then
				table.insert(t, obj.Value)
			end
		end
		local ok, attrs = pcall(function() return obj:GetAttributes() end)
		if ok and attrs then
			for _, v in pairs(attrs) do
				if isImageLike(v) then
					table.insert(t, v)
				end
			end
		end
	end)
	return t
end

local function parseAssetId(id)
	if typeof(id) == "number" then
		return "rbxassetid://" .. tostring(id)
	elseif typeof(id) == "string" then
		id = id:gsub("%s+", "")
		if id == "" then return nil end

		if tonumber(id) then
			return "rbxassetid://" .. id
		elseif string.find(id, "rbxassetid://") or string.find(id, "rbxasset://") or string.find(id, "rbxthumb://") or string.find(id, "http") then
			return id
		end
	end
	return nil
end

