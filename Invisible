if InvisibleConnections then
    for _, v in pairs(InvisibleConnections) do
        v:Disconnect()
    end
    InvisibleConnections = nil
end

if InvisibleGui then
    pcall(function()
        InvisibleEnabled = false
        InvisibleGui:Destroy()
    end)
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Character, Humanoid, RootPart
local InvisibleEnabled = false
local IsLocked = false

local Parts = {}
local OriginalTransparency = {}
local LastCF = nil

local function CacheParts()
    Parts = {}
    OriginalTransparency = {}

    if not Character then return end        

    for _, v in ipairs(Character:GetDescendants()) do        
        if v:IsA("BasePart") then        
            Parts[#Parts + 1] = v        
            OriginalTransparency[v] = v.Transparency        
        end        
    end
end

local function SetTransparency(value)
    for _, part in ipairs(Parts) do
        if part and part.Parent then
            part.Transparency = value
        end
    end
end

local function ResetTransparency()
    for part, trans in pairs(OriginalTransparency) do
        if part and part.Parent then
            part.Transparency = trans
        end
    end
end

local function SetupCharacter(char)
    Character = char
    Humanoid = char:WaitForChild("Humanoid")
    RootPart = char:WaitForChild("HumanoidRootPart")

    CacheParts()        

    if not InvisibleEnabled then        
        ResetTransparency()        
        Humanoid.CameraOffset = Vector3.zero        
    end
end

SetupCharacter(LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait())
LocalPlayer.CharacterAdded:Connect(SetupCharacter)

