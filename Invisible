local dragging = false
local dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    InvisibleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

InvisibleBtn.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not IsLocked then
        dragging = true
        dragStart = input.Position
        startPos = InvisibleBtn.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

InvisibleBtn.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and not IsLocked then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging and not IsLocked then
        update(input)
    end
end)

LockMove.MouseButton1Click:Connect(function()
    IsLocked = not IsLocked
    if IsLocked then
        Icon.ImageColor3 = Color3.fromRGB(255, 255, 0)
        Icon.Image = "rbxassetid://78340628553221"
    else
        Icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
        Icon.Image = "rbxassetid://131243965606901"
    end
end)

local function UpdateCheck(state)
    if state then
        Check.Visible = true
    end
    TweenService:Create(Check, TweenInfo.new(0.25), {
        ImageTransparency = state and 0 or 1
    }):Play()
    task.delay(0.25, function()
        if not state then
            Check.Visible = false
        end
    end)
end

InvisibleBtn.MouseButton1Click:Connect(function()
    InvisibleEnabled = not InvisibleEnabled

    if not InvisibleEnabled then        
        if RootPart and LastCF then
            RootPart.CFrame = LastCF
        end

        ResetTransparency()        
        if Humanoid then        
            Humanoid.CameraOffset = Vector3.zero        
        end        
    end        

    UpdateCheck(InvisibleEnabled)
end)

local Connections = {}

Connections[1] = RunService.Heartbeat:Connect(function()
    if not InvisibleEnabled or not Character or not Humanoid or not RootPart then
        return
    end

    local cf = RootPart.CFrame        
    LastCF = cf

    local newCF = cf * CFrame.new(0, -10000, 0)
    RootPart.CFrame = newCF * CFrame.Angles(math.rad(0.002), 0, 0)

    local camOffset = Humanoid.CameraOffset        
    local offset = newCF:ToObjectSpace(CFrame.new(cf.Position)).Position        

    Humanoid.CameraOffset = offset        

    RunService.RenderStepped:Wait()        

    if not InvisibleEnabled then return end        

    RootPart.CFrame = cf        
    Humanoid.CameraOffset = camOffset        

    SetTransparency(0.76)
end)

InvisibleConnections = Connections
